# ---------------------------------------------------------------------------
# Browser (VITE_ prefixed vars are inlined into the client bundle)
# ---------------------------------------------------------------------------
# Leave empty to use the Vite dev proxy (/api/v1 -> VITE_API_PROXY)
VITE_API_URL=
# Where the Vite dev proxy forwards /api/v1 during `npm run dev`
VITE_API_PROXY=http://localhost:8000
# Set to "true" to run the UI on placeholder data with no backend
VITE_USE_MOCK=false

# ---------------------------------------------------------------------------
# Server only - NEVER prefix these with VITE_, or they end up in the bundle.
# Read by the /api/ai/* handlers (dev middleware and serverless alike).
# ---------------------------------------------------------------------------
# Groq API key (console.groq.com). Leave unset to run entirely on the built-in
# waste rules - the app degrades gracefully rather than erroring.
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b). Groq uses strict
# json_schema mode, so the model must emit every required key. Verified against
# this schema: gpt-oss-120b ~3s and covers all action types; qwen/qwen3.8-27b
# works but is slower; gpt-oss-20b fails validation (omits `safety`).
ADVICE_MODEL=
# Below this confidence the UI asks for a rescan instead of advising (default 0.5).
# This is an app policy, NOT the model's own floor (that is ECOSCAN_CONF below).
ADVICE_MIN_CONFIDENCE=0.5

# Facility lookup (OpenStreetMap Overpass - no key required).
# Overpass asks callers to identify themselves; set your own contact in production.
OVERPASS_USER_AGENT=
# Worst case the user waits for facilities, in ms (default 8000).
OVERPASS_BUDGET_MS=

# ---------------------------------------------------------------------------
# Python backend (read by backend/main.py)
# ---------------------------------------------------------------------------
# Minimum confidence the MODEL itself will report a detection at (default 0.25).
# Kept low on purpose: a cluttered frame should return every item, not just the
# most obvious one.
ECOSCAN_CONF=0.25

# NMS IoU threshold (default 0.45) - stops a bottle next to a box from
# suppressing its neighbour.
ECOSCAN_IOU=0.45

# Inference size (default 960). Higher keeps small items - caps, batteries,
# scrap paper - from disappearing in a busy frame, at some latency cost.
ECOSCAN_IMGSZ=960

# Maximum detections returned per frame (default 40).
ECOSCAN_MAX_DET=40
